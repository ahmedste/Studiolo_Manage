# Copy to .env.local for local runs. On Vercel, add these under Project → Settings → Environment Variables.
# Never commit real values. Every key below should be READ-ONLY.

# --- Access -------------------------------------------------------------
# Password for the dashboard (any username). Required outside local dev.
DASHBOARD_PASSWORD=
# 1 = show demo numbers instead of calling vendor APIs.
DASHBOARD_SAMPLE=0
# Monthly active users, for cost-per-user (until it's read from Studiolo's database).
ACTIVE_USERS=20

# --- Vercel: live cost (FOCUS billing API) ---------------------------------
# Account Settings → Tokens. Scope it to the team. Leave empty while on Hobby.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# 0 on Hobby, 20 on Pro.
VERCEL_PLAN_FEE=0

# --- Neon: usage × Launch-plan prices ------------------------------------
# Account settings → API keys (or an org API key). Usage history needs a paid plan.
NEON_API_KEY=
NEON_ORG_ID=
# Shown while NEON_API_KEY is empty.
NEON_FIXED_MONTHLY=20

# --- Cloudflare: R2 + Workers + Images usage × list prices ----------------
# My Profile → API Tokens → Create custom token with:
#   Account → Account Analytics: Read, Account → Cloudflare Images: Read
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_PLAN_FEE=5

# --- Trigger.dev: sum of per-run cost ------------------------------------
# Either a personal access token (tr_pat_...) + project ref (proj_...),
# or the PRODUCTION secret key (tr_prod_...) on its own.
TRIGGER_ACCESS_TOKEN=
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
# Hobby: 10 / 10. Pro: 50 / 50.
TRIGGER_PLAN_FEE=10
TRIGGER_INCLUDED_USAGE=10

# --- Loops: fixed fee (no billing API) -----------------------------------
LOOPS_MONTHLY_FEE=0

# --- ElevenLabs: characters × pay-as-you-go rate --------------------------
# Profile → API keys. Restrict the key to "User: Read".
ELEVENLABS_API_KEY=
# 0.08 for Eleven v4, 0.04 for v4 Turbo.
ELEVENLABS_RATE_PER_1K=0.08
ELEVENLABS_INCLUDED_CHARS=10000
ELEVENLABS_PLAN_FEE=0

# --- Anthropic: live cost (Usage & Cost Admin API) ------------------------
# Needs an ORGANIZATION account (Console → Settings → Organization) and an Admin key
# (sk-ant-admin01-...). Comma-separate keys to add up several organizations.
ANTHROPIC_ADMIN_KEYS=
ANTHROPIC_MONTHLY_CREDITS=300
