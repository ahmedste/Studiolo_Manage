--- /dev/null
+++ b/tests/support/no-live-services.ts
@@ -0,0 +1,8 @@
+/**
+ * Vitest setupFiles for every run (unit, integration, branches): runs in each worker before every test file, so no
+ * test, and no script a test starts (the invite command inherits this env), ever reaches the real Loops account, even
+ * with the owner's keys in `.env.local`. Tests that check Loops calls pass their own key and fetch stub.
+ */
+process.env.LOOPS_API_KEY = "";
+process.env.LOOPS_WAITLIST_LIST_ID = "";
+process.env.LOOPS_INVITE_TRANSACTIONAL_ID = "";
